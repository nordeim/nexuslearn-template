// NexusLearn — LMS workspace
// Prisma schema (SQLite). Domain model of the cloned reference app:
// login users, course catalog with lessons, enrollments with per-lesson
// progress, contact messages and newsletter subscribers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  avatarColor   String   @default("#996CE4")
  // Signup flow (session 5): new accounts start unverified and must confirm
  // a 6-digit code via POST /api/auth/verify. Seeded accounts are verified.
  emailVerified Boolean  @default(true)
  // Session 35 — the verification-code persistence (the first half of the
  // DEPLOYMENT §13 SMTP drill): the signup route PERSISTS the code as an
  // HMAC-SHA256 hash (never the raw digits — a DB leak must not expose
  // live codes) with a 10-minute expiry, and the verify route compares for
  // real when AUTH_DELIVERY=smtp (the env gate; the simulated any-code
  // contract stays the dev/test default). Both fields clear on success.
  // Pre-35 the code was logged and discarded — any 6-digit string verified.
  verificationCode String?
  codeExpiresAt    DateTime?
  // Session 34 — the per-user epoch (the revocation lever). Embedded in the
  // session token at mint time (`ver`) and re-compared on every getSession()
  // read: bumping it (UPDATE User SET sessionVersion = sessionVersion + 1)
  // revokes every outstanding token for that user WITHOUT rotating the
  // global AUTH_SECRET; deleting the user row revokes them too (the
  // deleted-user ghost-token gap — see docs/remediation-plan-session34.md).
  sessionVersion Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments Enrollment[]
}

model Course {
  id              String   @id @default(cuid())
  title           String
  description     String
  // "About This Course" long text (reference app populates it for 4 courses;
  // absent -> the section is not rendered)
  longDescription String?
  category        String // Business | Technology | Marketing | Design | Personal Development | Programming | AI & Innovation
  level           String   @default("Beginner") // Beginner | Intermediate | Advanced | All Levels
  rating          Float    @default(4.8)
  students        Int      @default(0)
  hours           Int      @default(20)
  lessonsCount    Int      @default(50)
  instructorName  String
  instructorTitle String   @default("Course Instructor")
  instructorAvatar String
  image           String
  price           Float
  originalPrice   Float
  featured        Boolean  @default(false)
  sortOrder       Int      @default(0)
  // "What You'll Learn" topics (comma-separated; SQLite has no scalar lists —
  // parsed by src/lib/course-tags.ts). The level is appended at render time.
  tags            String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lessons      Lesson[]
  enrollments Enrollment[]

  @@index([category])
  @@index([featured])
}

model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  duration  Int      @default(10) // minutes
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  LessonProgress[]

  @@index([courseId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  progress    Int       @default(0) // 0-100, derived from completed lessons
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  LessonProgress[]

  @@unique([userId, courseId])
  @@index([userId])
}

model LessonProgress {
  id           String    @id @default(cuid())
  enrollmentId String
  lessonId     String
  completed    Boolean   @default(false)
  completedAt  DateTime?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("General Inquiry")
  message   String
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
